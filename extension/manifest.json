{
  "manifest_version": 3,
  "name": "Vilod HH",
  "version": "0.13.15",
  "description": "Поиск HH, профиль, материалы и проверяемые черновики. Автоотправка отключена.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://hh.ru/*",
    "https://*.hh.ru/*",
    "https://api.hh.ru/*"
  ],
  "options_page": "dashboard.html",
  "background": {
    "type": "module",
    "service_worker": "worker.mjs"
  }
}
